# systemd unit for a Raspberry Pi hub. Install the binary at /usr/local/lib/hub/hub and
# the image defaults at /etc/hub/hub.yaml. Self-upgrade writes the new binary next to the
# running one, renames it into place and re-execs (same PID), so the service user must
# own that folder (image/customize.sh).
[Unit]
Description=DHIS2 facility hub
After=network-online.target
Wants=network-online.target

[Service]
User=hub
ExecStart=/usr/local/lib/hub/hub serve -config /etc/hub/hub.yaml
Restart=always
RestartSec=5
StateDirectory=hub
# The data folder and every file the hub writes are its own: the key slots and TLS keys
# are not for other local accounts (review R-26). Self-upgrade's new binary is then 0700
# too, which only the hub (and root) run.
StateDirectoryMode=0700
UMask=0077
# Ports 443 and 80 (https:// and http://dhis2.local), as an unprivileged user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# The hub runs only itself and nmcli, neither setuid; the ambient capability survives
# its re-exec at upgrade. No core dumps: they would hold the data key and records.
NoNewPrivileges=yes
PrivateTmp=yes
LimitCORE=0
# Nor swap: the data key and decrypted records stay in memory (review R-26).
MemorySwapMax=0
# The file system is read-only for the hub, except the folders below (review R-26).
# These are every place the hub writes on the image; a data_dir or usb_dir moved
# elsewhere must be added here. Writable without a line here: /var/lib/hub
# (StateDirectory: the data, the downloaded releases in bin/, SQLite's tmp/, hub.log)
# and /run/hub (RuntimeDirectory: the setup Wi-Fi's captive flag, internal/netsetup).
ProtectSystem=strict
ProtectHome=yes
RuntimeDirectory=hub
# Self-upgrade writes the new binary next to the running one and renames it into
# place; a rollback copies hub.prev back (internal/upgrade).
ReadWritePaths=/usr/local/lib/hub
# The box's USB stick, usb_dir in hub.yaml: the setup code, then the copy a new disk
# is restored from (internal/stick). The image ships the empty folder; "-" starts the
# hub anyway if it is gone. A stick mounted later shows up here, writable.
ReadWritePaths=-/media/hub-usb

[Install]
WantedBy=multi-user.target
