# systemd unit for a Raspberry Pi hub. Install the binary at /usr/local/lib/hub/hub and
# the image defaults at /etc/hub/hub.yaml. Self-upgrade writes the new binary next to the
# running one, renames it into place and re-execs (same PID), so the service user must
# own that folder (image/customize.sh).
[Unit]
Description=DHIS2 facility hub
After=network-online.target
Wants=network-online.target

[Service]
User=hub
ExecStart=/usr/local/lib/hub/hub serve -config /etc/hub/hub.yaml
Restart=always
RestartSec=5
StateDirectory=hub
# Ports 443 and 80 (https:// and http://dhis2.local), as an unprivileged user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
