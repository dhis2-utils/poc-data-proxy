# The box's USB stick (FAT or exFAT), mounted for the hub at /media/hub-usb: the setup
# code before set-up, then the copy a new disk is restored from (docs/RECOVERY.md, C2).
# Any stick is mounted; once set up, the hub copies only to the one holding its mark.
# Its file system is on a partition, or on the whole stick when it has no partition
# table (the whole disk of a partitioned stick has no ID_FS_TYPE).
# A Pi started from a USB disk has its own boot partition (FAT) on USB too: the image's
# partitions are left out by the disk's identifier, which image/build.sh writes in
# place of the hub disk ID below (ID_PART_ENTRY_UUID is "<disk ID>-01" for the boot
# partition). exFAT has no "flush" option, so it gets its own line (review R-31).
ACTION!="add", GOTO="hub_usb_end"
SUBSYSTEM!="block", GOTO="hub_usb_end"
ENV{ID_BUS}!="usb", GOTO="hub_usb_end"
ENV{DEVTYPE}!="partition|disk", GOTO="hub_usb_end"
ENV{ID_PART_ENTRY_UUID}=="@HUB_DISK_ID@-*", GOTO="hub_usb_end"
ENV{ID_FS_TYPE}=="vfat", RUN{program}+="/usr/bin/systemd-mount --no-block --collect --owner=hub --options=flush,umask=0077 /dev/%k /media/hub-usb"
ENV{ID_FS_TYPE}=="exfat", RUN{program}+="/usr/bin/systemd-mount --no-block --collect --owner=hub --options=umask=0077 /dev/%k /media/hub-usb"
LABEL="hub_usb_end"
